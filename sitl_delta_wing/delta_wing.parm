# ══════════════════════════════════════════════════════════════════════════
#  delta_wing.parm —— 小展弦比三角翼（巡飞弹类）起始参数
#
#  这些值【由 lesson09k_delta_wing.py 的估算结果推导】，不是抄来的：
#      S = 2.5625 m²   b = 2.50 m   c̄ = 1.220 m   AR = 2.44
#      质量 180 kg，巡航 50 m/s，L/D = 5.1 ~ 8.5
#
#  ⚠️⚠️ 气动系数是 [B]/[C] 级估算，本参数只是【整定的起点】，
#        必须在 SITL 里逐步试出来，不能直接上真机。
# ══════════════════════════════════════════════════════════════════════════

# ── 舵面配置 ────────────────────────────────────────────────────────────
# 用 SERVO 功能号而非已废弃的 ELEVON_OUTPUT。
# 77 = ElevonLeft, 78 = ElevonRight（对应 03b-04 讲的 channel_function_mixer）
SERVO1_FUNCTION      77
SERVO2_FUNCTION      78
SERVO3_FUNCTION      70
# 弹射触发通道：SITL 的 SIM_Plane 用【第 7 路舵机 > 1700】触发弹射器
# ⚠️ 功能号必须【非零】，否则 MAV_CMD_DO_SET_SERVO 会被静默忽略（实测踩过）
SERVO7_FUNCTION      28
# ⚠️ 2026-09-29 实测修正：必须是 0/0
#    初版照抄官方 plane-elevons.parm 的 1/1，结果飞机在地上怎么都不抬头
#    （舵面在动、速度到 33 m/s，高度仍 0.0 m）。三组对照实测：
#        1/1 → 最大高度  +0.0 m   ← 错误
#        0/0 → 最大高度 +25.5 m   ← ✓ 正确
#        1/0 → 最大高度 +12.4 m   ← 滚转轴错
#    官方那份参数是给另一架飞机（常规 elevon 布局）的，不能照搬。
SERVO1_REVERSED      0
SERVO2_REVERSED      0

# ── 速度 ────────────────────────────────────────────────────────────────
# ⚠️⚠️ 先读这段，否则速度全设错：
#
#   SIM_Plane 的质量是【硬编码】的，无法用参数改成真机的 180 kg：
#        默认 2 kg   -heavy 8 kg   -jet 22 kg
#   （见 libraries/SITL/SIM_Plane.cpp:41/54/58）
#
#   气动系数是无量纲的，质量只改变配平动压：q = m·g/(S·C_L)，V = sqrt(2q/ρ)。
#   所以同一个模型在不同质量下的配平速度：
#
#        真机 180 kg  →  配平 50.0 m/s   Vs(CL=0.8) 37.5   AIRSPD_MIN 48.7
#        SITL -jet 22 →  配平 17.5 m/s   Vs         13.1   AIRSPD_MIN 17.0
#        SITL -heavy8 →  配平 10.5 m/s   Vs          7.9   AIRSPD_MIN 10.3
#        SITL 默认 2  →  配平  5.3 m/s   Vs          4.0   AIRSPD_MIN  5.1
#
#   差 sqrt(180/22) ≈ 2.9 倍。run_sitl.sh 用的是 -jet（22 kg），
#   所以下面按【22 kg 的 SITL】设值；真机值写在注释里供换算。
#
# 依据：CL_max = 1.209（Polhamus 峰值 @ α=33.5°），保守取 CL=0.8 算 Vs
AIRSPEED_CRUISE     18      # 真机对应 50
AIRSPEED_MIN        17      # 真机对应 48.7 —— 几乎顶到巡航
AIRSPEED_MAX        25      # 真机对应 70
ARSPD_USE            1
# ⚠️ 注意 AIRSPEED_MIN 几乎等于 AIRSPEED_CRUISE，这不是笔误 ——
#    本布局 CL_max 受限 + 升阻比低，可用速度窗口天然极窄。
#    这正是这类机型回收段/末端段特别难控的原因。
#
# ⚠️ 不要写 ARSPD_FBW_MIN / ARSPD_FBW_MAX —— ArduPlane 4.7.1 里
#    【没有这两个参数】（源码中只有同名的 C++ 常量 AIRSPEED_FBW_MIN），
#    写了会被静默忽略。速度范围就是上面 AIRSPEED_MIN/MAX 三个。

# ── 俯仰配平 ────────────────────────────────────────────────────────────
# 配平迎角 α = 8.67°（CL=0.450 @ V=50 m/s），平飞时俯仰角≈迎角
PTCH_TRIM_DEG       8.7
TRIM_THROTTLE       50
# 舵效随动压变化：控制面权限 ∝ q，无尾布局权限本就小，
# SCALING_SPEED 取巡航速度使舵效在巡航点归一
# ⚠️ 同样按 SITL 的 22 kg 设（真机对应 50）；设错会让舵量整体差 2.9 倍
SCALING_SPEED       18

# ── 姿态/速率环 ─────────────────────────────────────────────────────────
# ⚠️ 无尾布局的 C_m,δe 与 C_m,q 都比常规机型小得多
#    （估算 C_m,q = -0.76，而常规带平尾的 skywalker 是 -20）
#    → 俯仰阻尼弱、权限小，默认增益【一定】要重调。
#    下面先给保守值（比默认更软），方向是"降 P、增 D"。
PTCH_RATE_P          0.08
PTCH_RATE_I          0.06
PTCH_RATE_D          0.004
PTCH_RATE_FF         0.30
RLL_RATE_P           0.10
RLL_RATE_I           0.05
RLL_RATE_D           0.002
RLL_RATE_FF          0.18
PTCH2SRV_TCONST      0.35
RLL2SRV_TCONST       0.35

# ── 横侧向 ──────────────────────────────────────────────────────────────
# 无垂尾 → 航向是弱轴。C_n,β 估算 -0.056（常规机 -0.08~-0.15）。
# KFF_RDDRMIX：用副翼指令前馈差动，部分补偿转弯时的不利偏航
KFF_RDDRMIX          0.3
# 航向阻尼弱 → L1 周期放长，给控制系统更多时间
NAVL1_PERIOD         25
NAVL1_DAMPING        0.75

# ── TECS（能量控制）─────────────────────────────────────────────────────
# ⚠️ TECS 默认是按 L/D≈10 的常规机型给的。
#    本机 L/D 只有 5.1~8.5，不重调会导致爬升/下滑都不可控。
#    下面按 L/D≈5（悲观，对应尖前缘无吸力）整定。
# 速度尺度是 1/2.9，爬升/下沉率同步缩放（真机值 = 括号内 ×2.9）
TECS_CLMB_MAX        1.0    # 真机 ≈ 2.9
TECS_SINK_MIN        0.9    # 真机 ≈ 2.6
TECS_SINK_MAX        4.1    # 真机 ≈ 12
TECS_TIME_CONST      7.0
TECS_THR_DAMP        0.5
TECS_PITCH_MAX       10
TECS_PITCH_MIN      -10

# ── 其他 ────────────────────────────────────────────────────────────────
KFF_THR2PTCH         0.0
FLIGHT_OPTIONS       0
LOG_BITMASK          65535
